{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCTV Viewer",
  "version": "1.0.2",
  "identifier": "com.cctvviewer.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "windows": [
      {
        "title": "CCTV Viewer",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/cctv-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
