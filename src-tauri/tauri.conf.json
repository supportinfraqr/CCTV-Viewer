{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCTV Viewer",
  "version": "1.0.8",
  "identifier": "com.cctvviewer.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "CCTV Viewer",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/cctv-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyMTNGNjA1Q0VEMjNDRDMKUldUVFBOTE9CZllUZ284Nkd6dnN2RkxQbnhrcGc1eC96aEhhdUhaSU9LcmJXSkt2WFBmQVFzWk4K",
      "endpoints": [
        "https://github.com/supportinfraqr/CCTV-Viewer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
